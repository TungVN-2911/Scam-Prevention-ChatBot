# Google Gemini API — dùng cho LLM gateway
GEMINI_API_KEY=

# Pinecone — vector database cho RAG (dịch vụ cloud, không cần chạy container)
PINECONE_API_KEY=
PINECONE_INDEX=scam-prevention-knowledge-base

# Môi trường ứng dụng: local | dev | production
APP_ENV=local

# URL backend để frontend Streamlit gọi tới
BACKEND_URL=http://localhost:8000

# Ollama — dùng để tạo embedding local cho RAG
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# SQL Server — lưu lịch sử chat (conversation session) và Learning Progress (XP)
# Vi du: Driver={ODBC Driver 17 for SQL Server};Server=...;Database=...;UID=...;PWD=...;TrustServerCertificate=yes
SQL_SERVER_CONNECTION_STRING=

# JWT Secret Key — dùng để tạo và xác thực JWT token cho API
JWT_SECRET_KEY=

# URL của MCP Server (standalone, chạy Streamable HTTP) — dùng khi Chat gọi tool qua MCP
MCP_SERVER_URL=http://127.0.0.1:8020/mcp